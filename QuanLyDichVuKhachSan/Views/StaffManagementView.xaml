<UserControl x:Class="QuanLyDichVuKhachSan.Views.StaffManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:QuanLyDichVuKhachSan.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Header -->
                <RowDefinition Height="Auto"/> <!-- Top: Staff Table & Add Staff Form -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>    <!-- Bottom: Weekly Timetable -->
            </Grid.RowDefinitions>

            <!-- Header with Current Duty Staff Card on top right -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="👥 QUẢN LÝ ĐỘI NGŨ LỄ TÂN &amp; THỜI KHÓA BIỂU CA TRỰC" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Quản lý danh sách nhân viên và điều phối lịch trực lễ tân khách sạn" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Thẻ nhân viên trực ca hiện tại -->
                <Border Grid.Column="1" Style="{StaticResource StatCard}" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14,8" MinWidth="260">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="👤 NHÂN VIÊN TRỰC CA HIỆN TẠI" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                        <TextBlock Text="{Binding CurrentDutyStaffDisplay}" FontSize="16" FontWeight="Bold" Foreground="#2563EB" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top Section: Staff DataGrid & Add Form -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bảng nhân viên (Chỉ đọc như label, click để chọn) -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📋 DANH SÁCH NHÂN VIÊN KHÁCH SẠN" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>

                        <!-- DataGrid hoàn toàn chỉ đọc (IsReadOnly=True) -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding Data.StaffList}" 
                                  SelectedItem="{Binding SelectedStaffToAssign, Mode=TwoWay}"
                                  IsReadOnly="True" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  Height="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã NV" Binding="{Binding Code}" Width="75" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="150" FontWeight="Bold"/>
                                <DataGridTextColumn Header="CCCD" Binding="{Binding IdentityCard}" Width="120"/>
                                <DataGridTextColumn Header="SĐT" Binding="{Binding PhoneNumber}" Width="100"/>
                                <DataGridTextColumn Header="Chức Vụ" Binding="{Binding Position}" Width="100"/>
                                <DataGridTextColumn Header="Lương Cơ Bản" Binding="{Binding BaseSalary, Converter={StaticResource CurrencyConv}}" Width="105"/>
                                <DataGridTemplateColumn Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Xóa" Style="{StaticResource RedButton}" Height="24" Padding="4,0" FontSize="10.5"
                                                    Command="{Binding DataContext.DeleteStaffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,8,0,0">
                            <TextBlock Text="{Binding SelectedStaffDisplayName}" FontWeight="Bold" Foreground="#1E40AF" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Form Thêm nhân viên mới -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="➕ THÊM NHÂN VIÊN MỚI" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mã NV:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewStaffCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="30"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Họ Và Tên:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewStaffName, UpdateSourceTrigger=PropertyChanged}" 
                                         helpers:InputHelper.ValidationMode="NameOnly"
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="30"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số CCCD:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewStaffCccd, UpdateSourceTrigger=PropertyChanged}" 
                                         helpers:InputHelper.ValidationMode="PhoneOnly"
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="30"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Số Điện Thoại:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewStaffPhone, UpdateSourceTrigger=PropertyChanged}" 
                                         helpers:InputHelper.ValidationMode="PhoneOnly"
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="30"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Chức Vụ:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewStaffPosition, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="30"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Lương Cơ Bản:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewStaffSalary, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="30"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Thêm Nhân Viên Vào Danh Sách" Style="{StaticResource PrimaryButton}" Height="32" FontSize="11.5" FontWeight="Bold" Command="{Binding AddStaffCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Section: THỜI KHÓA BIỂU -->
            <Border Grid.Row="3" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header & Navigation -->
                        <RowDefinition Height="Auto"/> <!-- Week Title Bar -->
                        <RowDefinition Height="Auto"/> <!-- Timetable 7-Day Board -->
                        <RowDefinition Height="Auto"/> <!-- Action Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header & Navigation -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📅 THỜI KHÓA BIỂU" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>

                        <!-- Week Switcher -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="◀ Tuần Trước" Command="{Binding PrevWeekCommand}" Style="{StaticResource PrimaryButton}" Background="#64748B" Height="30" Padding="8,0" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="Tuần Hiện Tại" Command="{Binding CurrentWeekCommand}" Style="{StaticResource PrimaryButton}" Background="#2563EB" Height="30" Padding="10,0" FontSize="11" FontWeight="Bold" Margin="0,0,4,0"/>
                            <Button Content="Tuần Tới (Xếp Ca) ▶" Command="{Binding NextWeekCommand}" Style="{StaticResource PrimaryButton}" Background="#D97706" Height="30" Padding="8,0" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Week Date Range Bar -->
                    <Border Grid.Row="1" Margin="0,0,0,10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="{Binding WeekTitleDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Weekly Timetable 7 Columns Grid -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding WeeklyDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="3" Padding="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Day Header -->
                                            <RowDefinition Height="Auto"/> <!-- Shift 1: Sáng -->
                                            <RowDefinition Height="Auto"/> <!-- Shift 2: Chiều -->
                                            <RowDefinition Height="Auto"/> <!-- Shift 3: Đêm -->
                                        </Grid.RowDefinitions>

                                        <!-- Day Header -->
                                        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DayName}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding DateDisplay}" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Ca Sáng -->
                                        <Button Grid.Row="1" Margin="0,0,0,4" Padding="0" Background="Transparent" BorderThickness="0"
                                                DataContext="{Binding MorningShift}"
                                                Click="ShiftSlot_Click" 
                                                ContextMenuOpening="ShiftSlot_ContextMenuOpening"
                                                Cursor="Hand">
                                            <Border Background="{Binding SlotBg}" 
                                                    BorderBrush="{Binding CardBorderBrush}" 
                                                    BorderThickness="{Binding CardBorderThickness}" 
                                                    CornerRadius="6" Padding="6,5">
                                                <StackPanel>
                                                    <TextBlock Text="☀️ Ca Sáng (06:00-14:00)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding StaffName}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBadgeFg}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>

                                        <!-- Ca Chiều -->
                                        <Button Grid.Row="2" Margin="0,0,0,4" Padding="0" Background="Transparent" BorderThickness="0"
                                                DataContext="{Binding AfternoonShift}"
                                                Click="ShiftSlot_Click" 
                                                ContextMenuOpening="ShiftSlot_ContextMenuOpening"
                                                Cursor="Hand">
                                            <Border Background="{Binding SlotBg}" 
                                                    BorderBrush="{Binding CardBorderBrush}" 
                                                    BorderThickness="{Binding CardBorderThickness}" 
                                                    CornerRadius="6" Padding="6,5">
                                                <StackPanel>
                                                    <TextBlock Text="🌤️ Ca Chiều (14:00-22:00)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding StaffName}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBadgeFg}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>

                                        <!-- Ca Đêm -->
                                        <Button Grid.Row="3" Margin="0,0,0,0" Padding="0" Background="Transparent" BorderThickness="0"
                                                DataContext="{Binding NightShift}"
                                                Click="ShiftSlot_Click" 
                                                ContextMenuOpening="ShiftSlot_ContextMenuOpening"
                                                Cursor="Hand">
                                            <Border Background="{Binding SlotBg}" 
                                                    BorderBrush="{Binding CardBorderBrush}" 
                                                    BorderThickness="{Binding CardBorderThickness}" 
                                                    CornerRadius="6" Padding="6,5">
                                                <StackPanel>
                                                    <TextBlock Text="🌙 Ca Đêm (22:00-06:00)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding StaffName}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBadgeFg}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Action Bar -->
                    <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedStaffDisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📅 PHÂN CÔNG LỊCH TRỰC" Command="{Binding AssignSelectedSlotCommand}" Style="{StaticResource PrimaryButton}" Background="#16A34A" Height="36" Padding="14,0" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"/>
                                <Button Content="❌ HỦY CÁC CA ĐANG CHỌN" Command="{Binding ClearSlotCommand}" Style="{StaticResource PrimaryButton}" Background="#EF4444" Height="36" Padding="12,0" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
