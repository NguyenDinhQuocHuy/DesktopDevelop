<Window x:Class="QuanLyDichVuKhachSan.Views.SelectPartnerDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bàn Giao Đồ Cho Đối Tác Giặt Ủi - Dalat Hotel" 
        Width="540" SizeToContent="Height" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="16">
        <Border Background="White" CornerRadius="14" Padding="24,20" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🚚 BÀN GIAO ĐỒ CHO ĐỐI TÁC GIẶT ỦI" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,14"/>

                <!-- Thông tin đơn hàng tóm tắt -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                            <TextBlock Text="Mã Đơn Hàng:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtOrderCode" Text="DH-GU-001" FontWeight="Bold" FontSize="13" Foreground="#0284C7"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                            <TextBlock Text="Khách Hàng / Phòng:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtCustomerInfo" Text="Nguyễn Văn A (P.101)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                            <TextBlock Text="Loại Dịch Vụ:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtServiceType" Text="Giặt sấy khô thông thường" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                            <TextBlock Text="Khối Lượng &amp; Giá Bán:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtWeightAndPrice" Text="3.5 Kg · 105.000 đ" FontWeight="Bold" FontSize="12" Foreground="#D97706"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="Hẹn Trả Khách Lúc:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtAppointment" Text="18:00 04/09/2026" FontWeight="SemiBold" FontSize="12" Foreground="#15803D"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Chọn Đối tác nhận đơn -->
                <TextBlock Text="Chọn Đối Tác Giặt Ủi Bàn Giao (*):" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbPartner" Height="40" Margin="0,0,0,8"
                          DisplayMemberPath="Name"
                          Style="{StaticResource ModernComboBox}"
                          SelectionChanged="CmbPartner_SelectionChanged"/>

                <!-- Chi tiết đối tác được chọn -->
                <Border x:Name="BorderPartnerDetail" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtPartnerName" Text="Tiệm Giặt Sấy Tốc Hành EcoClean" FontWeight="Bold" FontSize="13" Foreground="#1D4ED8"/>
                        <TextBlock x:Name="TxtPartnerAddress" Text="📍 Địa chỉ: Số 12 Đường Hoa Cúc, P.7, Đà Lạt" FontSize="11.5" Foreground="#3B82F6" Margin="0,2,0,2"/>
                        <TextBlock x:Name="TxtPartnerPhone" Text="📞 SĐT: 02633445566" FontSize="11.5" Foreground="#3B82F6" Margin="0,0,0,2"/>
                        <TextBlock x:Name="TxtPartnerCommission" Text="💰 Khách sạn nhận: 30% doanh thu" FontSize="11.5" FontWeight="SemiBold" Foreground="#B45309"/>
                    </StackPanel>
                </Border>

                <!-- Nút bấm -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="❌ Đóng" Height="38" FontSize="12.5" FontWeight="SemiBold"
                            Style="{StaticResource OutlineButton}" Click="BtnCancel_Click"/>

                    <Button Grid.Column="2" Content="🚚 Xác Nhận Bàn Giao" Height="38" FontSize="12.5" FontWeight="Bold"
                            Style="{StaticResource PrimaryButton}" Click="BtnConfirm_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
