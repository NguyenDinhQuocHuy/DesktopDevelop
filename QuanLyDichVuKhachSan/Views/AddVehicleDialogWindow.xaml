<Window x:Class="QuanLyDichVuKhachSan.Views.AddVehicleDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:QuanLyDichVuKhachSan.Models"
        mc:Ignorable="d"
        Title="Thêm Xe Cho Thuê Mới - Dalat Hotel" 
        Width="560" SizeToContent="Height" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="16">
        <Border Background="White" CornerRadius="14" Padding="24,20" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🏍️ THÊM XE MÁY CHO THUÊ MỚI" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>

                <!-- Mã tự sinh & Biển số xe -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã Xe (Tự sinh):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtCode" Style="{StaticResource ModernTextBox}" Height="36" IsReadOnly="True" Background="#F1F5F9" FontWeight="Bold" Foreground="#0284C7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Biển Số Xe:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtLicensePlate" Style="{StaticResource ModernTextBox}" Height="36" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tên Xe:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}" Height="36"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Phân Loại Phương Tiện:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CboType" Height="36">
                            <ComboBoxItem Content="Xe tay ga" Tag="{x:Static models:VehicleType.Scooter}" IsSelected="True"/>
                            <ComboBoxItem Content="Xe số" Tag="{x:Static models:VehicleType.Manual}"/>
                            <ComboBoxItem Content="Xe côn tay" Tag="{x:Static models:VehicleType.Clutch}"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Giá Thuê / Ngày (VNĐ):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtDailyRate" Style="{StaticResource ModernTextBox}" Height="36" FontWeight="Bold" Foreground="#D97706" TextChanged="TxtDailyRate_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tiền Cọc Quy Định (30%):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtRequiredDeposit" Style="{StaticResource ModernTextBox}" Height="36" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Trạng Thái Hoạt Động:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                <ComboBox x:Name="CboStatus" Height="36" Margin="0,0,0,10">
                    <ComboBoxItem Content="Sẵn sàng" Tag="{x:Static models:VehicleStatus.Available}" IsSelected="True"/>
                    <ComboBoxItem Content="Đang bảo trì" Tag="{x:Static models:VehicleStatus.Maintenance}"/>
                    <ComboBoxItem Content="Đang cho thuê" Tag="{x:Static models:VehicleStatus.Rented}"/>
                </ComboBox>

                <TextBlock Text="Tình Trạng Chi Tiết / Ghi Chú:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtConditionNote" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,18" Text="Xe mới, máy êm, kèm 2 mũ bảo hiểm"/>

                <!-- Nút bấm Hủy (Reset form) và Xác nhận (Thêm mới) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" Click="BtnCancel_Click" Height="36" Width="90" Margin="0,0,10,0" Style="{StaticResource OutlineButton}"/>
                    <Button Content="Xác nhận" Click="BtnSave_Click" Height="36" Width="120" Style="{StaticResource PrimaryButton}" Background="#16A34A"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
