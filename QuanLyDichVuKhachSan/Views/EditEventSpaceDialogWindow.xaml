<Window x:Class="QuanLyDichVuKhachSan.Views.EditEventSpaceDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:QuanLyDichVuKhachSan.Models"
        mc:Ignorable="d"
        Title="Chỉnh Sửa Sảnh &amp; Phòng Hội Nghị - Dalat Hotel" 
        Width="560" SizeToContent="Height" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="16">
        <Border Background="White" CornerRadius="14" Padding="24,20" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🏛️ CHỈNH SỬA THÔNG TIN SẢNH / PHÒNG HỘI NGHỊ" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>

                <TextBlock Text="Tên Sảnh / Khu Vực:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Loại Khu Vực:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSpaceType" Style="{StaticResource ModernTextBox}" Height="36"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sức Chứa (Người):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtCapacity" Style="{StaticResource ModernTextBox}" Height="36" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Giá Thuê Theo Giờ (VNĐ/giờ):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtHourlyRate" Style="{StaticResource ModernTextBox}" Height="36" FontWeight="Bold" Foreground="#D97706" Margin="0,0,0,10"/>

                <TextBlock Text="Trạng Thái Hoạt Động:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                <ComboBox x:Name="CboStatus" Height="36" Margin="0,0,0,10">
                    <ComboBoxItem Content="Trống / Sẵn sàng" Tag="{x:Static models:SpaceStatus.Available}"/>
                    <ComboBoxItem Content="Đang cho thuê" Tag="{x:Static models:SpaceStatus.Rented}"/>
                    <ComboBoxItem Content="Đang dọn dẹp" Tag="{x:Static models:SpaceStatus.Cleaning}"/>
                    <ComboBoxItem Content="Đang sửa chữa / Bảo trì" Tag="{x:Static models:SpaceStatus.Maintenance}"/>
                </ComboBox>

                <TextBlock Text="Mô Tả Trang Thiết Bị / Ghi Chú:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtEquipments" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,18"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" Click="BtnCancel_Click" Height="36" Width="90" Margin="0,0,10,0" Style="{StaticResource OutlineButton}"/>
                    <Button Content="Xác nhận" Click="BtnSave_Click" Height="36" Width="120" Style="{StaticResource PrimaryButton}" Background="#16A34A"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
