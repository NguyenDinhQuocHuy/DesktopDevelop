<UserControl x:Class="QuanLyDichVuKhachSan.Views.TransactionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:QuanLyDichVuKhachSan.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">

    <UserControl.DataContext>
        <viewmodels:TransactionHistoryViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="Auto"/> <!-- Summary KPI Cards -->
            <RowDefinition Height="Auto"/> <!-- Filter & Search Toolbar -->
            <RowDefinition Height="*"/>    <!-- Transaction DataGrid -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="📜 LỊCH SỬ GIAO DỊCH &amp; HÓA ĐƠN ĐÃ THANH TOÁN" FontSize="19" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Theo dõi toàn bộ các giao dịch thanh toán phòng và xuất hóa đơn riêng của tất cả dịch vụ" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="🔄 Làm Mới Dữ Liệu" Style="{StaticResource ModernButton}" Height="34" Padding="14,0"/>
        </Grid>

        <!-- 2. KPI Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Tổng giao dịch -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TỔNG SỐ GIAO DỊCH ĐÃ THANH TOÁN" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} Giao dịch'}" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Tổng tiền thu được -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TỔNG TIỀN QUYẾT TOÁN" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalAmountSum, StringFormat='{}{0:N0} đ'}" FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Nhân viên trực ca hiện tại -->
            <Border Grid.Column="4" Style="{StaticResource StatCard}" Background="#EFF6FF" BorderBrush="#BFDBFE">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="👤 NHÂN VIÊN TRỰC CA HIỆN TẠI" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                    <TextBlock Text="{Binding CurrentDutyStaffDisplay}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Filter & Search Toolbar -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#F1F5F9" CornerRadius="8,0,0,8" Padding="10,0" BorderBrush="#CBD5E1" BorderThickness="1,1,0,1">
                        <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Foreground="#64748B"/>
                    </Border>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" Height="34" 
                             ToolTip="Tìm theo Mã đơn, Tên khách, Số phòng hoặc Tên nhân viên..."
                             VerticalContentAlignment="Center" FontSize="12.5"/>
                </Grid>

                <!-- Category Filter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Dịch vụ:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}" 
                              Style="{StaticResource ModernComboBox}" Height="34" Width="170"/>
                </StackPanel>

                <!-- Date Range -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Từ:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Height="34" Width="120"/>
                    <TextBlock Text="Đến:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Height="34" Width="120"/>
                </StackPanel>

                <Button Grid.Column="6" Command="{Binding ResetDateCommand}" Content="30 Ngày Gần Nhất" Style="{StaticResource OutlineButton}" Height="34" Padding="10,0"/>
            </Grid>
        </Border>

        <!-- 4. Transactions DataGrid -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Padding="0">
            <DataGrid ItemsSource="{Binding FilteredTransactions}" 
                      SelectedItem="{Binding SelectedTransaction}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      HeadersVisibility="Column"
                      RowHeight="40"
                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🧾 Xem Chi Tiết Hóa Đơn" 
                                  Click="MenuItem_OpenDetail_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="ToolTip" Value="Nháy đúp chuột để xem chi tiết hóa đơn thanh toán"/>
                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- Mã Giao Dịch -->
                    <DataGridTextColumn Header="Mã Giao Dịch" Binding="{Binding TransactionCode}" Width="135" FontWeight="Bold" Foreground="#2563EB"/>

                    <!-- Loại Dịch Vụ (Badge) -->
                    <DataGridTemplateColumn Header="Loại Dịch Vụ" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ServiceBadgeBg}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ServiceCategory}" FontWeight="Bold" FontSize="11" Foreground="{Binding ServiceBadgeFg}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Khách Hàng -->
                    <DataGridTextColumn Header="Khách Hàng" Binding="{Binding CustomerName}" Width="160" FontWeight="Bold" Foreground="#0F172A"/>

                    <!-- Phòng / Khách -->
                    <DataGridTextColumn Header="Phòng / Khách" Binding="{Binding RoomDisplay}" Width="130" FontWeight="SemiBold"/>

                    <!-- Thời Gian Thanh Toán -->
                    <DataGridTextColumn Header="Thời Gian Thanh Toán" Binding="{Binding PaymentTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="155"/>

                    <!-- Tổng Tiền -->
                    <DataGridTextColumn Header="Số Tiền Thu" Binding="{Binding Amount, StringFormat='{}{0:N0} đ'}" Width="125" FontWeight="Bold" Foreground="#D97706"/>

                    <!-- Hình Thức Thanh Toán -->
                    <DataGridTextColumn Header="Hình Thức" Binding="{Binding PaymentMethod}" Width="180"/>

                    <!-- Người Lập -->
                    <DataGridTextColumn Header="Người Lập" Binding="{Binding CreatedBy}" Width="130"/>

                    <!-- Người Thu Tiền / Trực Ca -->
                    <DataGridTextColumn Header="Thu Ngân / Trực Ca" Binding="{Binding PaidBy}" Width="145" FontWeight="SemiBold" Foreground="#059669"/>

                    <!-- Trạng Thái -->
                    <DataGridTemplateColumn Header="Trạng Thái" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cột Thao tác -->
                    <DataGridTemplateColumn Header="Xem Chi Tiết" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🔍 Xem Bill" Style="{StaticResource OutlineButton}" Height="26" Padding="6,0" FontSize="11" FontWeight="Bold"
                                        Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
