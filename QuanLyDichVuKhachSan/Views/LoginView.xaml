<UserControl x:Class="QuanLyDichVuKhachSan.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="480" 
             Background="#FFFFFF"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">

    <!-- Card bo gọn khít với cửa sổ -->
    <Border Background="White" Padding="32,24" VerticalAlignment="Center">
        <StackPanel>
            <!-- Header Logo & Title -->
            <TextBlock Text="🏨 DALAT HOTEL" FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
            <TextBlock Text="HỆ THỐNG QUẢN LÝ DỊCH VỤ" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,16"/>

            <!-- Username Field -->
            <TextBlock Text="👤 Tên đăng nhập" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     KeyDown="OnInputKeyDown"
                     Style="{StaticResource ModernTextBox}" 
                     Height="40" 
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12"/>

            <!-- Password Field with Eye Toggle -->
            <TextBlock Text="🔒 Mật khẩu" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,8">
                <!-- Masked PasswordBox -->
                <PasswordBox x:Name="TxtPassword"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             KeyDown="OnInputKeyDown"
                             Style="{StaticResource ModernPasswordBox}" 
                             Height="40" 
                             Padding="10,4,40,4"
                             VerticalContentAlignment="Center"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource InvBoolToVis}}"/>

                <!-- Unmasked Plain TextBox -->
                <TextBox x:Name="TxtPasswordUnmasked"
                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnInputKeyDown"
                         Style="{StaticResource ModernTextBox}" 
                         Height="40" 
                         Padding="10,4,40,4"
                         VerticalContentAlignment="Center"
                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>

                <!-- Eye Icon Toggle Button -->
                <Button Command="{Binding TogglePasswordVisibilityCommand}"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Width="34" Height="34" 
                        Margin="0,0,4,0"
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        ToolTip="Ẩn / Hiện mật khẩu">
                    <TextBlock Text="{Binding EyeIcon}" 
                               FontSize="15" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Dòng chữ nhỏ màu đỏ phía dưới ô nhập mật khẩu khi sai thông tin -->
            <StackPanel Orientation="Horizontal" Margin="2,-2,0,8" 
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="⚠️ " FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#DC2626" 
                           FontSize="11.5" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Remember Me Checkbox -->
            <CheckBox Content="Ghi nhớ thông tin đăng nhập" 
                      IsChecked="{Binding RememberMe}" 
                      FontSize="12" FontWeight="SemiBold" 
                      Foreground="#475569" 
                      Margin="2,0,0,16" 
                      Cursor="Hand"/>

            <!-- Login Button -->
            <Button Command="{Binding LoginCommand}" Content="ĐĂNG NHẬP VÀO HỆ THỐNG" IsDefault="True" Height="44" Style="{StaticResource PrimaryButton}" Background="#D97706" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
