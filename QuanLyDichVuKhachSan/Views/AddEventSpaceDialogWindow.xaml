<Window x:Class="QuanLyDichVuKhachSan.Views.AddEventSpaceDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:QuanLyDichVuKhachSan.Models"
        mc:Ignorable="d"
        Title="Thêm Khu Vực Sự Kiện Mới - Dalat Hotel" 
        Width="560" SizeToContent="Height" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="16">
        <Border Background="White" CornerRadius="14" Padding="24,20" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🏛️ THÊM KHU VỰC / SẢNH SỰ KIỆN MỚI" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>

                <!-- Mã tự sinh & Tên khu vực -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã Khu Vực (Tự sinh):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtCode" Style="{StaticResource ModernTextBox}" Height="36" IsReadOnly="True" Background="#F1F5F9" FontWeight="Bold" Foreground="#0284C7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tên Sảnh / Khu Vực:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}" Height="36"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Loại Khu Vực:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CboSpaceType" Height="36" IsEditable="True">
                            <ComboBoxItem Content="Sảnh lớn" IsSelected="True"/>
                            <ComboBoxItem Content="Phòng họp kín"/>
                            <ComboBoxItem Content="Sân thượng ngoài trời"/>
                            <ComboBoxItem Content="Phòng nhỏ trong nhà"/>
                            <ComboBoxItem Content="Sân vườn ngoài trời"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sức Chứa (Người):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtCapacity" Style="{StaticResource ModernTextBox}" Height="36" FontWeight="Bold" Text="50"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Giá Thuê Theo Giờ (VNĐ/giờ):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtHourlyRate" Style="{StaticResource ModernTextBox}" Height="36" FontWeight="Bold" Foreground="#D97706" Text="500,000" Margin="0,0,0,10"/>

                <TextBlock Text="Trạng Thái Hoạt Động:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                <ComboBox x:Name="CboStatus" Height="36" Margin="0,0,0,10">
                    <ComboBoxItem Content="Trống / Sẵn sàng" Tag="{x:Static models:SpaceStatus.Available}" IsSelected="True"/>
                    <ComboBoxItem Content="Đang bảo trì" Tag="{x:Static models:SpaceStatus.Maintenance}"/>
                    <ComboBoxItem Content="Đang dọn dẹp" Tag="{x:Static models:SpaceStatus.Cleaning}"/>
                </ComboBox>

                <TextBlock Text="Mô Tả Trang Thiết Bị / Ghi Chú:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtEquipments" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,18" Text="Màn chiếu, âm thanh cơ bản, ánh sáng tiêu chuẩn"/>

                <!-- Nút bấm Hủy (Reset form) và Xác nhận (Thêm mới) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" Click="BtnCancel_Click" Height="36" Width="90" Margin="0,0,10,0" Style="{StaticResource OutlineButton}"/>
                    <Button Content="Xác nhận" Click="BtnSave_Click" Height="36" Width="120" Style="{StaticResource PrimaryButton}" Background="#16A34A"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
