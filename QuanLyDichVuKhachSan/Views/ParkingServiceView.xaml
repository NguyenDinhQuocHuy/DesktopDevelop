<UserControl x:Class="QuanLyDichVuKhachSan.Views.ParkingServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:QuanLyDichVuKhachSan.Models"
             xmlns:helpers="clr-namespace:QuanLyDichVuKhachSan.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1150"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🅿️ QUẢN LÝ BÃI &amp; HẦM ĐỖ XE" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bảng danh sách xe đang trong bãi -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🚗 DANH SÁCH XE TRONG BÃI &amp; LỊCH SỬ GỬI XE" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                    
                    <!-- Thanh tìm kiếm Real-time -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBox x:Name="TxtSearchParking"
                                 Text="{Binding SearchParkingQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Padding="28,0,10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="12"
                                 Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8" 
                                   VerticalAlignment="Center" HorizontalAlignment="Left" 
                                   Margin="8,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Tìm kiếm khách hàng theo tên/số điện thoại" 
                                   FontSize="12" Foreground="#94A3B8" FontStyle="Italic"
                                   VerticalAlignment="Center" Margin="28,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=TxtSearchParking}" Value=""/>
                                                <Condition Binding="{Binding IsKeyboardFocused, ElementName=TxtSearchParking}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredParkingRecords}" SelectedItem="{Binding SelectedRecord}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Vé" Binding="{Binding TicketCode}" Width="90" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Biển Số" Binding="{Binding LicensePlate}" Width="110" FontWeight="Bold" Foreground="#0284C7"/>
                            <DataGridTextColumn Header="Loại Xe" Binding="{Binding VehicleType}" Width="95"/>
                            <DataGridTextColumn Header="Khách / Phòng" Binding="{Binding CustomerName}" Width="120"/>
                            <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="105"/>
                            <DataGridTextColumn Header="Giờ Vào" Binding="{Binding CheckInTime, StringFormat='{}{0:dd/MM HH:mm}'}" Width="110"/>
                            <DataGridTextColumn Header="Hình Thức" Binding="{Binding ChargeTypeDisplay}" Width="140"/>
                            <DataGridTextColumn Header="Phí Gửi" Binding="{Binding ParkingFee, Converter={StaticResource CurrencyConv}}" Width="95" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Ghi Chú" Binding="{Binding RepairNote}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Column: Tiếp nhận xe & Quyết toán xe ra -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Form Tiếp nhận gửi xe mới -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="✍️ TIẾP NHẬN XE VÀO BÃI" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Biển Số Xe (*):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding LicensePlate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Loại Phương Tiện:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <ComboBox SelectedValue="{Binding VehicleType}" SelectedValuePath="Content" Height="34">
                                    <ComboBoxItem Content="Xe máy" IsSelected="True"/>
                                    <ComboBoxItem Content="Ô tô"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tên Khách Gửi:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" 
                                         helpers:InputHelper.ValidationMode="NameOnly"
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Số Phòng:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding Data.AvailableRoomNumbers}" 
                                          Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}" 
                                          IsEditable="True" 
                                          Style="{StaticResource ModernComboBox}" 
                                          Height="34"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số Điện Thoại:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                                         helpers:InputHelper.ValidationMode="PhoneOnly"
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ngày Giờ Vào:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CheckInTimeStr}" IsReadOnly="True" Background="#F1F5F9" Style="{StaticResource ModernTextBox}" Height="34"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hình Thức Thu Phí:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <ComboBox SelectedValue="{Binding ChargeType}" SelectedValuePath="Tag" Height="34">
                                    <ComboBoxItem Content="🎫 Xe máy (5k/lượt)" Tag="{x:Static models:ParkingChargeType.ByTurn}" IsSelected="True"/>
                                    <ComboBoxItem Content="🚗 Ô tô (50k/giờ)" Tag="{x:Static models:ParkingChargeType.ByHour}"/>
                                    <ComboBoxItem Content="🏨 Khách phòng (Miễn phí)" Tag="{x:Static models:ParkingChargeType.ResidentFree}"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Phí Tạm Tính:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding ParkingFee, Converter={StaticResource CurrencyConv}}" IsReadOnly="True" Background="#F8FAFC" Style="{StaticResource ModernTextBox}" Height="34" FontWeight="Bold" Foreground="#D97706"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Ghi Chú:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding RepairNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,10"/>

                        <Button Content="🎫 TIẾP NHẬN VÀO BÃI &amp; IN VÉ XE" Style="{StaticResource GreenButton}" Height="36" FontSize="12.5" Command="{Binding CheckInCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Panel Quyết toán xe ra & Thu phí (Góc dưới bên phải) -->
                <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="💳 QUYẾT TOÁN XE RA &amp; THU TIỀN" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="📍 Chọn một xe trong danh sách bên trái để quyết toán:" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedRecord.LicensePlate, FallbackValue='---', StringFormat='{}Biển số: {0}'}" FontWeight="Bold" Foreground="#0284C7" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedRecord.VehicleType, FallbackValue='---', StringFormat='{}Loại: {0}'}" FontSize="12" Foreground="#475569"/>
                                </Grid>
                                <TextBlock Text="{Binding SelectedRecord.CustomerName, FallbackValue='---', StringFormat='{}Khách / Phòng: {0}'}" FontSize="11.5" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedRecord.CheckInTime, FallbackValue='---', StringFormat='{}Giờ vào: {0:dd/MM/yyyy HH:mm}'}" FontSize="11.5" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Thời lượng đỗ thực tế:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CalculatedDurationDisplay, FallbackValue='---'}" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Số tiền thanh toán:" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding CalculatedAmount, Converter={StaticResource CurrencyConv}}" FontSize="16" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="💳 THANH TOÁN &amp; XUẤT HÓA ĐƠN" Style="{StaticResource PrimaryButton}" Background="#D97706" Height="36" FontSize="12.5" Command="{Binding PayAndCheckOutCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
