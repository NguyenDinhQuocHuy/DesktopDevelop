<Window x:Class="QuanLyDichVuKhachSan.Views.ExtendStayDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gia Hạn Lưu Trú - Dalat Hotel" 
        Height="420" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="14" Padding="22" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Divider -->
                    <RowDefinition Height="*"/>    <!-- Body -->
                    <RowDefinition Height="Auto"/> <!-- Buttons -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="⏰ GIA HẠN THỜI GIAN LƯU TRÚ" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock x:Name="TxtRoomInfo" Text="Phòng: P.101 - Khách: Đoàn Minh Trí" FontSize="12.5" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,3,0,0"/>
                </StackPanel>

                <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,10,0,14"/>

                <!-- Body -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Thời gian trả phòng hiện tại:" FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtCurrentCheckOut" Text="12:00 30/08/2026" FontSize="13.5" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,12"/>

                    <!-- Quick Extend Buttons -->
                    <TextBlock Text="Gia hạn nhanh:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <Button Content="+ 1 Ngày" Click="BtnPlus1Day_Click" Height="34" Margin="0,0,4,0" Style="{StaticResource OutlineButton}"/>
                        <Button Content="+ 2 Ngày" Click="BtnPlus2Days_Click" Height="34" Margin="2,0,2,0" Style="{StaticResource OutlineButton}"/>
                        <Button Content="+ 3 Ngày" Click="BtnPlus3Days_Click" Height="34" Margin="2,0,2,0" Style="{StaticResource OutlineButton}"/>
                        <Button Content="+ 1 Tuần" Click="BtnPlus1Week_Click" Height="34" Margin="4,0,0,0" Style="{StaticResource OutlineButton}"/>
                    </UniformGrid>

                    <!-- Pick New Date -->
                    <TextBlock Text="Ngày trả phòng mới:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpNewCheckOutDate" Height="36" SelectedDateChanged="DpNewCheckOutDate_SelectedDateChanged" Margin="0,0,0,8"/>

                    <TextBlock Text="Giờ trả phòng (mặc định 12:00 trưa):" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbNewCheckOutHour" Height="34" SelectedIndex="12" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Actions -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="❌ Hủy Bỏ" Click="BtnCancel_Click" Height="38" Style="{StaticResource OutlineButton}" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="💾 Xác Nhận Gia Hạn" Click="BtnConfirm_Click" Height="38" Style="{StaticResource GoldButton}" Margin="6,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
