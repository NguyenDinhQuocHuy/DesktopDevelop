<Window x:Class="QuanLyDichVuKhachSan.Views.AddLaundryPartnerDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thêm Đối Tác Giặt Ủi Mới - Dalat Hotel" 
        Width="560" SizeToContent="Height" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="16">
        <Border Background="White" CornerRadius="14" Padding="24,20" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🧺 THÊM ĐỐI TÁC GIẶT ỦI LIÊN KẾT MỚI" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>

                <!-- Mã tự sinh & Tên đối tác -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã Đối Tác (Tự sinh):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtCode" Style="{StaticResource ModernTextBox}" Height="36" IsReadOnly="True" Background="#F1F5F9" FontWeight="Bold" Foreground="#0284C7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tên Tiệm / Đơn Vị Giặt Ủi:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}" Height="36"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Địa Chỉ Cơ Sở Giặt:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtAddress" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Số Điện Thoại Liên Hệ:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtPhoneNumber" Style="{StaticResource ModernTextBox}" Height="36"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Khách Sạn Hưởng Hoa Hồng (%):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtCommissionRate" Style="{StaticResource ModernTextBox}" Height="36" FontWeight="Bold" Foreground="#B45309" Text="30"/>
                    </StackPanel>
                </Grid>

                <!-- Bảng thiết lập giá vốn dịch vụ đối tác báo (Giá vốn < Giá niêm yết để khách sạn có lãi) -->
                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="📊 BẢNG GIÁ VỐN ĐỐI TÁC BÁO (Phải nhỏ hơn giá niêm yết):" FontSize="11.5" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Giặt sấy -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Giặt sấy (Bán: 30k):" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtCostSay" Text="21000" Style="{StaticResource ModernTextBox}" Height="34" TextChanged="TxtCost_TextChanged"/>
                                <TextBlock x:Name="LblProfitSay" Text="Lời: 9.000đ/kg" FontSize="10" Foreground="#16A34A" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Giặt hấp -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Giặt hấp (Bán: 80k):" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtCostHap" Text="56000" Style="{StaticResource ModernTextBox}" Height="34" TextChanged="TxtCost_TextChanged"/>
                                <TextBlock x:Name="LblProfitHap" Text="Lời: 24.000đ/kg" FontSize="10" Foreground="#16A34A" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Ủi phẳng -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Ủi phẳng (Bán: 40k):" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtCostUi" Text="28000" Style="{StaticResource ModernTextBox}" Height="34" TextChanged="TxtCost_TextChanged"/>
                                <TextBlock x:Name="LblProfitUi" Text="Lời: 12.000đ/kg" FontSize="10" Foreground="#16A34A" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="💡 Khách sạn hưởng lợi nhuận = [Giá niêm yết bán cho khách] − [Giá vốn trả đối tác]" FontSize="10.5" Foreground="#64748B" FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Trạng Thái Hợp Tác:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                <ComboBox x:Name="CboStatus" Height="36" Margin="0,0,0,18">
                    <ComboBoxItem Content="Đang hợp tác" IsSelected="True"/>
                    <ComboBoxItem Content="Tạm ngừng liên kết"/>
                </ComboBox>

                <!-- Nút bấm Hủy (Reset form) và Xác nhận (Thêm mới) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" Click="BtnCancel_Click" Height="36" Width="90" Margin="0,0,10,0" Style="{StaticResource OutlineButton}"/>
                    <Button Content="Xác nhận" Click="BtnSave_Click" Height="36" Width="120" Style="{StaticResource PrimaryButton}" Background="#16A34A"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
