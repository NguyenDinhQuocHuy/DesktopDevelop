<Window x:Class="QuanLyDichVuKhachSan.Views.AccountManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:QuanLyDichVuKhachSan.Helpers"
        mc:Ignorable="d"
        Title="Quản Lý Tài Khoản Người Dùng - Dalat Hotel" 
        Height="620" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Users DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Form Add / Edit -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="👑 QUẢN TRỊ TÀI KHOẢN HỆ THỐNG" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
        </Grid>

        <!-- DataGrid -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📋 DANH SÁCH TÀI KHOẢN HIỆN CÓ" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>

                <DataGrid x:Name="DgUsers" Grid.Row="1" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False"
                          RowHeight="40"
                          SelectionChanged="DgUsers_SelectionChanged"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên Đăng Nhập" Binding="{Binding Username}" Width="130" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Mật Khẩu" Binding="{Binding Password}" Width="110" Foreground="#D97706"/>
                        <DataGridTextColumn Header="Họ Và Tên" Binding="{Binding FullName}" Width="160"/>
                        <DataGridTextColumn Header="Vai Trò" Binding="{Binding RoleDisplayName}" Width="100" FontWeight="SemiBold"/>
                        
                        <!-- Trạng thái -->
                        <DataGridTemplateColumn Header="Trạng Thái" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsActive, Converter={StaticResource BoolToGreenRedBg}}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToActiveText}}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding IsActive, Converter={StaticResource BoolToGreenRedFg}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Nút Thao tác (Không hiển thị chữ Thao Tác trên Header) -->
                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding IsActive, Converter={StaticResource BoolToLockBtnText}}" 
                                            Background="{Binding IsActive, Converter={StaticResource BoolToLockBtnBg}}" 
                                            Click="BtnToggleStatus_Click" 
                                            Visibility="{Binding CanBeLocked, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource PrimaryButton}" 
                                            Height="28" 
                                            Width="64"
                                            FontSize="11" 
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Form Add/Edit -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel>
                <TextBlock x:Name="TxtFormTitle" Text="➕ THÊM / CẬP NHẬT TÀI KHOẢN" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Username -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tên Đăng Nhập (*):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtUsername" Style="{StaticResource ModernTextBox}" Height="34"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mật Khẩu (*):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtPassword" Style="{StaticResource ModernTextBox}" Height="34"/>
                    </StackPanel>

                    <!-- Full Name -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Họ Và Tên:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtFullName" helpers:InputHelper.ValidationMode="NameOnly" Style="{StaticResource ModernTextBox}" Height="34"/>
                    </StackPanel>

                    <!-- Role -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Vai Trò:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CboRole" Height="34" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="👑 Admin" Tag="Admin"/>
                            <ComboBoxItem Content="👩‍💼 Lễ Tân" Tag="Receptionist" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="ChkIsActive" Content="Kích hoạt đăng nhập (Active)" IsChecked="True" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <Button x:Name="BtnSave" Content="💾 Lưu Tài Khoản" Click="BtnSave_Click" Style="{StaticResource PrimaryButton}" Background="#2563EB" Height="36" Padding="14,0" FontSize="12" Margin="0,0,8,0"/>
                    <Button Content="🔄 Nhập Mới" Click="BtnReset_Click" Style="{StaticResource PrimaryButton}" Background="#64748B" Height="36" Padding="12,0" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
