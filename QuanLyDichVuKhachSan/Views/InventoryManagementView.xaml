<UserControl x:Class="QuanLyDichVuKhachSan.Views.InventoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1250"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Quick Refresh -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📦 QUẢN LÝ KHO HÀNG" FontSize="19" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Mô hình Chứng từ Thực tế &amp; Giá vốn Bình quân" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="🔄 Làm Mới Dữ Liệu" Style="{StaticResource ModernButton}" Height="32" Padding="12,0"/>
        </Grid>

        <!-- 2. KPI Summary Cards (Bỏ tổng tồn kho lẻ theo yêu cầu) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Mặt hàng quản lý -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MẶT HÀNG QUẢN LÝ" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalDryItemsCount, StringFormat='{}{0} Loại'}" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Cảnh báo tồn thấp -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}" Background="#FFFBEB" BorderBrush="#FDE68A">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="⚠️ CẢNH BÁO TỒN THẤP" FontSize="10.5" FontWeight="Bold" Foreground="#B45309"/>
                    <TextBlock Text="{Binding LowStockItemsCount, StringFormat='{}{0} Mặt Hàng'}" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Lô hàng cận hạn -->
            <Border Grid.Column="4" Style="{StaticResource StatCard}" Background="#FEF2F2" BorderBrush="#FECACA">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="⏰ LÔ HÀNG CẬN HẠN" FontSize="10.5" FontWeight="Bold" Foreground="#991B1B"/>
                    <TextBlock Text="{Binding NearExpiryBatchesCount, StringFormat='{}{0} Lô'}" FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Tab Bar Navigation (Đã tinh giản tiêu đề tab) -->
        <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="8" Padding="4" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="📥 1. LẬP PHIẾU NHẬP KHO" Command="{Binding SetTabCommand}" CommandParameter="Receipt" IsChecked="True" Style="{StaticResource SegmentTabButton}" Margin="0,0,4,0"/>
                <RadioButton Content="🏷️ 2. DANH MỤC MẶT HÀNG" Command="{Binding SetTabCommand}" CommandParameter="Catalog" Style="{StaticResource SegmentTabButton}" Margin="0,0,4,0"/>
                <RadioButton Content="📜 3. LỊCH SỬ NHẬP KHO" Command="{Binding SetTabCommand}" CommandParameter="History" Style="{StaticResource SegmentTabButton}"/>
            </StackPanel>
        </Border>

        <!-- 4. Content Workspace By Tab -->
        <Grid Grid.Row="3">

            <!-- ====================================================================== -->
            <!-- TAB 1: LẬP PHIẾU NHẬP KHO                                              -->
            <!-- ====================================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Receipt">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: FORM NHẬP HÀNG (ĐÃ BỎ TIÊU ĐỀ SOẠN DÒNG HÀNG NHẬP, CÓ NÚT CÂY BÚT KHÓA ĐVT & HỆ SỐ) -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Chọn Mặt Hàng -->
                            <TextBlock Text="Chọn Mặt Hàng Nhập:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding Data.FoodItems}" SelectedItem="{Binding SelectedItemToImport}" DisplayMemberPath="Name" Height="34" Margin="0,0,0,4"/>
                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                <TextBlock Text="{Binding ReferenceSpecAndPrice}" FontSize="10.5" FontWeight="SemiBold" Foreground="#15803D" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Quy cách ĐVT & Hệ số quy đổi (Cố định từ danh mục cấu hình mặt hàng) -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="QUY CÁCH ĐVT &amp; HỆ SỐ QUY ĐỔI" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>

                                    <!-- 2 Ô Input: Hiển thị cố định (ReadOnly) theo cấu hình mặt hàng -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ĐVT Lúc Nhập:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding ImportUnit, Mode=OneWay}" 
                                                     IsReadOnly="True"
                                                     Background="#F1F5F9"
                                                     Style="{StaticResource ModernTextBox}" Height="32"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Hệ Số Quy Đổi Lẻ:" FontSize="10.5" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding ConversionRate, Mode=OneWay}" 
                                                     IsReadOnly="True"
                                                     Background="#F1F5F9"
                                                     Style="{StaticResource ModernTextBox}" Height="32" FontWeight="Bold" Foreground="#0284C7"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Số lượng & Đơn giá nhập sỉ -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Số Lượng (ĐVT Nhập):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding ImportQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="32" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Giá Nhập / 1 ĐVT:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding ImportPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" Style="{StaticResource ModernTextBox}" Height="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Số Lô & HSD -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Số Lô In Bao Bì:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Hạn Sử Dụng (HSD):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <DatePicker SelectedDate="{Binding ExpiryDate}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- Ghi chú dòng hàng -->
                            <TextBlock Text="Ghi Chú Dòng Hàng:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding LineNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="30" Margin="0,0,0,10"/>

                            <!-- Xem trước tính toán -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📊 XEM TRƯỚC TÍNH TOÁN DÒNG HÀNG:" FontSize="10.5" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding TotalRetailUnitsDisplay, StringFormat='{}📦 Tồn lẻ cộng thêm: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding TotalImportCostDisplay, StringFormat='{}💰 Tổng tiền dòng: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding CostPerRetailUnitDisplay, StringFormat='{}🚀 Giá vốn 1 đơn vị lẻ: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#059669" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding AddDraftItemCommand}" Content="➕ Thêm Dòng Hàng Vào Phiếu" Style="{StaticResource ModernButton}" Background="#0284C7" Height="36" FontWeight="Bold"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- CỘT PHẢI: BẢNG CÁC DÒNG HÀNG ĐANG LẬP TRONG PHIẾU NHẬP -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header Thông Tin Phiếu Nhập -->
                            <RowDefinition Height="*"/>    <!-- DataGrid Dòng Hàng Đang Soạn -->
                            <RowDefinition Height="Auto"/> <!-- Footer: Tổng Hợp & Lập Phiếu -->
                        </Grid.RowDefinitions>

                        <!-- Header Thông tin phiếu -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mã Phiếu Nhập (Auto):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding ReceiptCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="32" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nhà Cung Cấp / Nguồn Hàng:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding Data.Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Ghi Chú Chung Phiếu Nhập:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding ReceiptNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="32" ToolTip="Nhập số hóa đơn NCC, người giao hàng..."/>
                            </StackPanel>
                        </Grid>

                        <!-- DataGrid Danh Sách Dòng Hàng Đang Lập -->
                        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                            <DataGrid ItemsSource="{Binding DraftReceiptItems}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mặt Hàng" Binding="{Binding FoodItemName}" Width="160" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="ĐVT Nhập" Binding="{Binding ImportUnit}" Width="80"/>
                                    <DataGridTextColumn Header="Hệ Số" Binding="{Binding ConversionRate}" Width="60"/>
                                    <DataGridTextColumn Header="SL Nhập" Binding="{Binding Quantity}" Width="70" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Quy Đổi Lẻ" Binding="{Binding CalculationSummary}" Width="150"/>
                                    <DataGridTextColumn Header="Đơn Giá Nhập" Binding="{Binding ImportPrice, StringFormat='{}{0:N0} đ'}" Width="105"/>
                                    <DataGridTextColumn Header="Thành Tiền" Binding="{Binding TotalCost, StringFormat='{}{0:N0} đ'}" Width="110" FontWeight="Bold" Foreground="#D97706"/>
                                    <DataGridTextColumn Header="Số Lô" Binding="{Binding BatchNumber}" Width="85"/>
                                    <DataGridTextColumn Header="HSD" Binding="{Binding ExpiryDisplay}" Width="90"/>
                                    <DataGridTemplateColumn Header="Thao Tác" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="❌ Xóa" Command="{Binding DataContext.RemoveDraftItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#EF4444" Foreground="White" BorderThickness="0" Padding="4,2" FontSize="10" Cursor="Hand"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Footer: Tổng Hợp & Nút Hoàn Tất -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DraftItemsCount, StringFormat='{}📋 {0} Mặt hàng | '}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBlock Text="{Binding DraftTotalRetailUnits, StringFormat='{}📦 Tổng tồn lẻ: +{0} đơn vị | '}" FontSize="12" FontWeight="Bold" Foreground="#0284C7"/>
                                <TextBlock Text="{Binding DraftTotalCost, StringFormat='{}💰 Tổng hóa đơn: {0:N0} đ'}" FontSize="13" FontWeight="Bold" Foreground="#D97706"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CommitReceiptCommand}" Content="💾 LẬP PHIẾU &amp; CẬP NHẬT KHO" Style="{StaticResource ModernButton}" Background="#059669" Height="38" Padding="16,0" FontWeight="Bold"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================================================================== -->
            <!-- TAB 2: DANH MỤC MẶT HÀNG (ĐÃ BỎ QUY ĐỊNH KHO)                          -->
            <!-- ====================================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Catalog">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: BẢNG DANH MỤC HÀNG HÓA -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📋 DANH MỤC MẶT HÀNG KHO" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="30" ToolTip="Tìm kiếm theo tên mặt hàng..."/>
                        </Grid>

                        <DataGrid x:Name="CatalogDataGrid" Grid.Row="1" ItemsSource="{Binding FilteredCatalogItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" MouseDoubleClick="CatalogDataGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✏️ Chỉnh Sửa Mặt Hàng" Click="MenuItem_Edit_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🗑️ Xóa (Chuyển vào Thùng rác)" Click="MenuItem_Trash_Click" Foreground="#DC2626"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã MH" Binding="{Binding ItemCode}" Width="75" FontWeight="Bold" Foreground="#2563EB"/>
                                <DataGridTextColumn Header="Tên Mặt Hàng" Binding="{Binding Name}" Width="160" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Phân Loại" Binding="{Binding Category}" Width="90" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="ĐVT Bán Lẻ" Binding="{Binding RetailUnit}" Width="85"/>
                                <DataGridTextColumn Header="Giá Bán Lẻ" Binding="{Binding Price, StringFormat='{}{0:N0} đ'}" Width="105" FontWeight="Bold" Foreground="#2563EB"/>
                                <DataGridTextColumn Header="Giá Vốn Bình Quân" Binding="{Binding AverageCostPrice, StringFormat='{}{0:N0} đ'}" Width="125" FontWeight="SemiBold" Foreground="#059669"/>
                                <DataGridTextColumn Header="Tồn Kho Lẻ" Binding="{Binding StockDisplay}" Width="95" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Ngưỡng Báo" Binding="{Binding LowStockThreshold}" Width="85"/>
                                <DataGridTextColumn Header="ĐVT Nhập Mặc Định" Binding="{Binding DefaultImportUnit}" Width="120"/>
                                <DataGridTextColumn Header="Hệ Số Quy Đổi" Binding="{Binding DefaultConversionRate}" Width="95"/>
                                <DataGridTemplateColumn Header="Trạng Thái (Phục Vụ)" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" 
                                                          Cursor="Hand"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Status}" 
                                                           FontWeight="Bold" 
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- CỘT PHẢI: FORM THÊM MẶT HÀNG MỚI & THÙNG RÁC GÓC DƯỚI BÊN PHẢI -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. FORM THÊM MẶT HÀNG MỚI -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="➕ THÊM MẶT HÀNG MỚI" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                                <TextBlock Text="Mã Mặt Hàng:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding AutoGeneratedNewItemCode, Mode=OneWay}" IsReadOnly="True" Background="#F1F5F9" FontWeight="Bold" Foreground="#2563EB" Style="{StaticResource ModernTextBox}" Height="30" Margin="0,0,0,8"/>

                                <TextBlock Text="Tên Mặt Hàng:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,0,0,8"/>

                                <TextBlock Text="Phân Loại Mặt Hàng:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding NewItemCategory}" Style="{StaticResource ModernComboBox}" Height="32" Margin="0,0,0,8"/>

                                <TextBlock Text="Đơn Giá Bán Lẻ (VNĐ):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewItemPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" Style="{StaticResource ModernTextBox}" Height="32" FontWeight="Bold" Margin="0,0,0,8"/>

                                <TextBlock Text="Đơn Vị Bán Lẻ (Lon, Chai, Gói...):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewItemRetailUnit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ĐVT Nhập Mặc Định:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewItemDefaultImportUnit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Hệ Số Quy Đổi:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewItemDefaultConversionRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="32" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Ngưỡng Cảnh Báo Tồn Kho Thấp:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewItemLowStockThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,0,0,10"/>

                                <Button Command="{Binding AddNewFoodItemCommand}" Content="➕ LƯU MẶT HÀNG MỚI" Style="{StaticResource ModernButton}" Background="#2563EB" Height="36" FontWeight="Bold"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 2. NÚT THÙNG RÁC NHỎ GỌN ĐẶT GÓC DƯỚI BÊN PHẢI -->
                        <Border Grid.Row="1" Margin="0,10,0,0" Padding="0,6,0,0" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                            <Grid>
                                <Button x:Name="BtnTrash" Click="BtnTrash_Click" HorizontalAlignment="Right" Height="28" Cursor="Hand" Style="{StaticResource ModernButton}" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" Padding="8,0" ToolTip="Thùng rác tạm lưu (Nhấp để xem và khôi phục mặt hàng)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🗑️" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Thùng rác" FontSize="11" FontWeight="SemiBold" Foreground="#9F1239" VerticalAlignment="Center"/>
                                        <Border Background="#FFE4E6" CornerRadius="6" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TrashedItemsCount}" FontSize="9.5" FontWeight="Bold" Foreground="#BE123C"/>
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <!-- POPUP CHI TIẾT CÁC MẶT HÀNG BỊ XÓA -->
                                <Popup x:Name="TrashPopup" 
                                       PlacementTarget="{Binding ElementName=BtnTrash}" 
                                       Placement="Top" 
                                       StaysOpen="False" 
                                       AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#FDA4AF" BorderThickness="1.5" CornerRadius="12" Padding="14" Width="360" MaxHeight="380">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header Popup -->
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🗑️" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="THÙNG RÁC KHO HÀNG" FontSize="12.5" FontWeight="Bold" Foreground="#9F1239" VerticalAlignment="Center"/>
                                                    <Border Background="#FFE4E6" CornerRadius="10" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TrashedItemsCount, StringFormat='{}{0} món'}" FontSize="10" FontWeight="Bold" Foreground="#BE123C"/>
                                                    </Border>
                                                </StackPanel>
                                                <Button Content="✕" Click="BtnCloseTrashPopup_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Width="24" Height="24" Background="Transparent" BorderThickness="0" FontWeight="Bold" Foreground="#94A3B8" Cursor="Hand"/>
                                            </Grid>

                                            <!-- Content Popup -->
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                                                <StackPanel>
                                                    <!-- Khi thùng rác trống -->
                                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,20"
                                                            Visibility="{Binding HasTrashedItems, Converter={StaticResource InvBoolToVis}}">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="📭" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                            <TextBlock Text="Thùng rác hiện đang trống" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Các mặt hàng bị xóa sẽ lưu tạm 3 tháng để khôi phục." FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Danh sách mặt hàng khi có món -->
                                                    <ItemsControl ItemsSource="{Binding TrashedItems}"
                                                                  Visibility="{Binding HasTrashedItems, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#FFF1F2" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="#FECDD3" BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding ItemCode}" FontWeight="Bold" FontSize="11.5" Foreground="#2563EB" Margin="0,0,6,0"/>
                                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding TrashedDateDisplay}" FontSize="9.5" Foreground="#64748B" Margin="0,3,0,0"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <!-- Nút Khôi Phục -->
                                                                            <Button ToolTip="Khôi phục mặt hàng về danh mục kho" 
                                                                                    Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" 
                                                                                    Height="28" Padding="8,0" Margin="0,0,4,0" Cursor="Hand"
                                                                                    Command="{Binding DataContext.RestoreFoodItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="♻️" FontSize="11" Margin="0,0,3,0"/>
                                                                                    <TextBlock Text="Khôi phục" FontSize="10.5" FontWeight="Bold" Foreground="#15803D"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <!-- Nút Xóa Vĩnh Viễn -->
                                                                            <Button ToolTip="Xóa vĩnh viễn khỏi CSDL" 
                                                                                    Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" 
                                                                                    Height="28" Width="28" Cursor="Hand"
                                                                                    Command="{Binding DataContext.PermanentDeleteFoodItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <TextBlock Text="❌" FontSize="10" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================================================================== -->
            <!-- TAB 3: LỊCH SỬ NHẬP KHO (ĐÃ BỎ CHỮ FIFO)                               -->
            <!-- ====================================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="History">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📜 LỊCH SỬ CÁC LÔ HÀNG ĐÃ NHẬP KHO" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Data.InventoryBatches}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding ReceiptCode}" Width="125" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Mặt Hàng" Binding="{Binding FoodItemName}" Width="160" FontWeight="Bold"/>
                                <DataGridTextColumn Header="SL Nhập" Binding="{Binding Quantity}" Width="70"/>
                                <DataGridTextColumn Header="ĐVT" Binding="{Binding ImportUnit}" Width="75"/>
                                <DataGridTextColumn Header="Quy Đổi Lẻ" Binding="{Binding CalculationSummary}" Width="150"/>
                                <DataGridTextColumn Header="Giá Nhập" Binding="{Binding ImportPrice, StringFormat='{}{0:N0} đ'}" Width="105"/>
                                <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding TotalCost, StringFormat='{}{0:N0} đ'}" Width="110" FontWeight="Bold" Foreground="#D97706"/>
                                <DataGridTextColumn Header="Số Lô" Binding="{Binding BatchNumber}" Width="90"/>
                                <DataGridTextColumn Header="Hạn Dùng" Binding="{Binding ExpiryDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Nhà Cung Cấp" Binding="{Binding Supplier}" Width="140"/>
                                <DataGridTextColumn Header="Ngày Nhập" Binding="{Binding ImportDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="125"/>
                                <DataGridTextColumn Header="Người Nhập" Binding="{Binding ImportedBy}" Width="110"/>
                                <DataGridTextColumn Header="Ghi Chú" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
