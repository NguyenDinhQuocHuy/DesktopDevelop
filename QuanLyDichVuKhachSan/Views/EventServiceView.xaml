<UserControl x:Class="QuanLyDichVuKhachSan.Views.EventServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:QuanLyDichVuKhachSan.Helpers"
             xmlns:models="clr-namespace:QuanLyDichVuKhachSan.Models"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1180"
             PreviewMouseUp="UserControl_PreviewMouseUp"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🏛️ CHO THUÊ SẢNH, PHÒNG HỘI NGHỊ &amp; SỰ KIỆN" FontSize="19" FontWeight="Bold" Foreground="#1E293B"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: 2 TAB (TỔNG QUAN vs THỜI KHÓA BIỂU MULTI-SELECT TƯƠNG TÁC) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Tab Switcher Bar -->
                    <RowDefinition Height="*"/>    <!-- Workspace Content -->
                </Grid.RowDefinitions>

                <!-- Tab Switcher Bar Cột Trái -->
                <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="8" Padding="3" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="🏢 1. TỔNG QUAN &amp; LỊCH SỬ" 
                                     IsChecked="{Binding IsOverviewTab, Mode=OneWay}"
                                     Command="{Binding SetLeftTabCommand}" 
                                     CommandParameter="Overview"
                                     Style="{StaticResource SegmentTabButton}"/>
                        <RadioButton Grid.Column="1" Content="📅 2. THỜI KHÓA BIỂU (06H-23H)" 
                                     IsChecked="{Binding IsTimetableTab, Mode=OneWay}"
                                     Command="{Binding SetLeftTabCommand}" 
                                     CommandParameter="Timetable"
                                     Style="{StaticResource SegmentTabButton}"/>
                    </Grid>
                </Border>

                <!-- TAB 1: TỔNG QUAN KHU VỰC + LỊCH SỬ ĐƠN ĐẶT -->
                <Grid Grid.Row="1" Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Danh sách sảnh / phòng sự kiện -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="🏢 DANH SÁCH KHU VỰC SỰ KIỆN" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <Button Content="➕ Thêm Khu Vực" HorizontalAlignment="Right"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                        Height="28" Padding="10,0" FontSize="11.5" FontWeight="SemiBold"
                                        Background="#0284C7" Foreground="White" BorderThickness="0"
                                        Cursor="Hand" Click="BtnAddSpace_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Data.EventSpaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                                Cursor="Hand" 
                                                ContextMenuOpening="Border_ContextMenuOpening"
                                                ToolTip="Click để chọn sảnh. Click chuột phải để Chỉnh sửa thông tin sảnh (Admin)">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="✏️ Chỉnh sửa" 
                                                              FontWeight="Bold" Foreground="#0284C7"
                                                              Click="MenuItem_EditSpace_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.SelectSpaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding DisplayIcon}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding HourlyRate, Converter={StaticResource CurrencyConv}, StringFormat='{}Giá thuê: {0}/giờ'}" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Equipments}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Capacity, StringFormat='{}Sức chứa: {0} người'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Lịch sử các đơn đặt sảnh -->
                    <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📑 LỊCH SỬ ĐƠN ĐẶT SẢNH" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                            
                            <!-- Khung Bộ Lọc & Tìm Kiếm Nâng Cao (Thời Gian + Trạng Thái + Tìm Kiếm) -->
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Hàng 1: Thời gian & Chọn khoảng ngày -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Thời gian:" FontSize="12.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <RadioButton Content="Hôm Nay" GroupName="TimeFilter_Event" Command="{Binding SetTimeFilterCommand}" CommandParameter="Today" IsChecked="{Binding IsTodayTimeFilter, Mode=TwoWay}" FontWeight="Bold" FontSize="12" Foreground="#2563EB" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <RadioButton Content="Tất Cả" GroupName="TimeFilter_Event" Command="{Binding SetTimeFilterCommand}" CommandParameter="All" IsChecked="{Binding IsAllTimeFilter, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <RadioButton Content="Khoảng Ngày" GroupName="TimeFilter_Event" Command="{Binding SetTimeFilterCommand}" CommandParameter="Custom" IsChecked="{Binding IsCustomTimeFilter, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12" Foreground="#059669" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- DatePicker Từ ngày - Đến ngày -->
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Từ:" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Height="28" FontSize="11.5" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="2" Text="Đến:" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}" Height="28" FontSize="11.5"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>

                                    <!-- Hàng 2: Lọc theo trạng thái đơn sảnh -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Trạng thái:" FontSize="12.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                            <RadioButton Content="Tất Cả" GroupName="StatusFilter_Event" Command="{Binding SetStatusFilterCommand}" CommandParameter="All" IsChecked="{Binding IsAllStatusFilter, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <RadioButton Content="Đã Cọc" GroupName="StatusFilter_Event" Command="{Binding SetStatusFilterCommand}" CommandParameter="Đã cọc" IsChecked="{Binding IsDepositStatusFilter, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12" Foreground="#B45309" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <RadioButton Content="Đã Thanh Toán Hết" GroupName="StatusFilter_Event" Command="{Binding SetStatusFilterCommand}" CommandParameter="Đã thanh toán full" IsChecked="{Binding IsFullPaidStatusFilter, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12" Foreground="#7E22CE" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <RadioButton Content="Đang Sử Dụng" GroupName="StatusFilter_Event" Command="{Binding SetStatusFilterCommand}" CommandParameter="Đang sử dụng" IsChecked="{Binding IsInUseStatusFilter, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12" Foreground="#0284C7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <RadioButton Content="Hoàn Tất" GroupName="StatusFilter_Event" Command="{Binding SetStatusFilterCommand}" CommandParameter="Hoàn tất" IsChecked="{Binding IsCompletedStatusFilter, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12" Foreground="#15803D" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <RadioButton Content="Đã Hủy" GroupName="StatusFilter_Event" Command="{Binding SetStatusFilterCommand}" CommandParameter="Đã hủy" IsChecked="{Binding IsCancelledStatusFilter, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12" Foreground="#DC2626" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </Grid>

                                    <!-- Hàng 3: Thanh tìm kiếm Real-time -->
                                    <Grid>
                                        <TextBox x:Name="TxtSearchBooking"
                                                 Text="{Binding SearchBookingQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="32"
                                                 Padding="28,0,10,0"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="12"
                                                 Style="{StaticResource ModernTextBox}"/>
                                        <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                   Margin="8,0,0,0" IsHitTestVisible="False"/>
                                        <TextBlock Text="Tìm kiếm khách hàng theo tên/số điện thoại" 
                                                   FontSize="12" Foreground="#94A3B8" FontStyle="Italic"
                                                   VerticalAlignment="Center" Margin="28,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Text, ElementName=TxtSearchBooking}" Value=""/>
                                                                <Condition Binding="{Binding IsKeyboardFocused, ElementName=TxtSearchBooking}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="GridEventBookings" Grid.Row="2" ItemsSource="{Binding FilteredEventBookings}" SelectedItem="{Binding SelectedBookingToComplete}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding BookingCode}" Width="85" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Khu Vực" Binding="{Binding SpaceName}" Width="135" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Khách Hàng" Binding="{Binding CustomerName}" Width="115"/>
                                    <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="105"/>
                                    <DataGridTextColumn Header="Bắt Đầu" Binding="{Binding StartTime, StringFormat='{}{0:dd/MM HH:mm}'}" Width="95"/>
                                    <DataGridTextColumn Header="Kết Thúc" Binding="{Binding EndTime, StringFormat='{}{0:dd/MM HH:mm}'}" Width="95"/>
                                    <DataGridTextColumn Header="Tiền Cọc" Binding="{Binding DepositAmount, Converter={StaticResource CurrencyConv}}" Width="85"/>
                                    <DataGridTextColumn Header="Tổng Dự Kiến" Binding="{Binding TotalEstimatedAmount, Converter={StaticResource CurrencyConv}}" Width="95" FontWeight="Bold" Foreground="#D97706"/>
                                    <DataGridTemplateColumn Header="Trạng Thái" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã cọc">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Đang sử dụng">
                                                                    <Setter Property="Background" Value="#E0F2FE"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã thanh toán full">
                                                                    <Setter Property="Background" Value="#F3E8FF"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã thanh toán">
                                                                    <Setter Property="Background" Value="#F3E8FF"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Hoàn tất">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã hoàn tất">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Ghi nợ vào phòng">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã hủy">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding PaymentStatus}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã cọc">
                                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Đang sử dụng">
                                                                        <Setter Property="Foreground" Value="#0369A1"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã thanh toán full">
                                                                        <Setter Property="Foreground" Value="#7E22CE"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã thanh toán">
                                                                        <Setter Property="Foreground" Value="#7E22CE"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Hoàn tất">
                                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã hoàn tất">
                                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Ghi nợ vào phòng">
                                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Đã hủy">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 2: THỜI KHÓA BIỂU SỬ DỤNG (CHỮ TO RÕ, HỖ TRỢ KÉO THẢ CHUỘT VÀ CTRL+CLICK) -->
                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="12" 
                        Visibility="{Binding IsTimetableTab, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Date Filter Bar + Clear Button -->
                            <RowDefinition Height="Auto"/> <!-- Space Switcher Tabs -->
                            <RowDefinition Height="Auto"/> <!-- Interactive Selection Notification -->
                            <RowDefinition Height="*"/>    <!-- Hourly Timeline List -->
                        </Grid.RowDefinitions>

                        <!-- 1. Thanh chọn ngày + Nút Hủy Chọn -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="◀ Trước" Command="{Binding PrevDayCommand}" Style="{StaticResource PrimaryButton}" Background="#64748B" Height="28" Padding="8,0" FontSize="11"/>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <DatePicker SelectedDate="{Binding SelectedTimetableDate}" Height="28" Margin="0,0,6,0" FontSize="12"/>
                                    <Button Content="Hôm Nay" Command="{Binding TodayCommand}" Style="{StaticResource PrimaryButton}" Background="#2563EB" Height="28" Padding="8,0" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Sau ▶" Command="{Binding NextDayCommand}" Style="{StaticResource PrimaryButton}" Background="#64748B" Height="28" Padding="8,0" FontSize="11" Margin="0,0,6,0"/>
                                
                                <Button Grid.Column="3" Content="❌ Hủy Chọn" Command="{Binding ClearSlotSelectionCommand}" Style="{StaticResource RedButton}" Height="28" Padding="10,0" FontSize="11" FontWeight="Bold" ToolTip="Bỏ chọn tất cả các khung giờ"/>
                            </Grid>
                        </Border>

                        <!-- 2. Tabs chuyển đổi theo từng Khu Vực Sự Kiện -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Data.EventSpaces}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" 
                                            Command="{Binding DataContext.SelectTimetableSpaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Height="30" Margin="2,0" FontSize="11" FontWeight="SemiBold"
                                            Padding="4,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Setter Property="Background" Value="#E2E8F0"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource CommonEqualityConverter}">
                                                                <Binding Path="Id"/>
                                                                <Binding Path="DataContext.SelectedTimetableSpace.Id" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="#2563EB"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 3. Thanh thông báo trạng thái Multi-Select & Kiểm tra tính liên tục -->
                        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8"
                                Visibility="{Binding SelectionStatusMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectionStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF" TextWrapping="Wrap"/>
                        </Border>

                        <!-- 4. Danh sách thời khóa biểu chi tiết từng tiếng (06h - 23h) - Chữ to rõ, kéo thả chuột & Ctrl+Click -->
                        <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding HourlyScheduleSlots}" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding SlotBg}" BorderBrush="{Binding BorderBrush}" BorderThickness="1.5" CornerRadius="6" Padding="10,8" Margin="0,0,0,5"
                                                    Cursor="Hand"
                                                    PreviewMouseDown="Slot_PreviewMouseDown"
                                                    MouseEnter="Slot_MouseEnter"
                                                    ToolTip="Nhấn giữ và kéo chuột từ giờ A đến giờ B (hoặc giữ phím Ctrl + Click) để chọn nhanh khung giờ!">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Cột Giờ (Ví dụ: 08:00 - 09:00 - Chữ to rõ) -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="⏱️" FontSize="12" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding TimeLabel}" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                                    </StackPanel>

                                                    <!-- Thông tin sự kiện (nếu đang sử dụng) -->
                                                    <TextBlock Grid.Column="1" Text="{Binding CustomerDetail}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0"/>

                                                    <!-- Badge Trạng thái: Trống / Đang chọn / Đang sử dụng (To rõ) -->
                                                    <Border Grid.Column="2" Background="{Binding SlotBg}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SlotFg}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- CỘT PHẢI: FORM TIẾP NHẬN ĐẶT SẢNH CỐ ĐỊNH & QUYẾT TOÁN -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Form Đặt sảnh mới -->
                        <TextBlock Text="✍️ TIẾP NHẬN ĐẶT SẢNH SỰ KIỆN" FontSize="14.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                        <TextBlock Text="Chọn Khu Vực:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding Data.EventSpaces}" SelectedItem="{Binding SelectedSpace}" DisplayMemberPath="Name" Height="32" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tên Khách Hàng:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding BookingCustomerName, UpdateSourceTrigger=PropertyChanged}" 
                                         helpers:InputHelper.ValidationMode="NameOnly"
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Số Phòng:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding Data.AvailableRoomNumbers}" 
                                          Text="{Binding BookingRoomNumber, UpdateSourceTrigger=PropertyChanged}" 
                                          IsEditable="True" 
                                          Style="{StaticResource ModernComboBox}" 
                                          Height="32"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Số Điện Thoại Liên Lạc:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding BookingPhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                                 helpers:InputHelper.ValidationMode="PhoneOnly"
                                 Style="{StaticResource ModernTextBox}" 
                                 Height="32" 
                                 Margin="0,0,0,6"/>

                        <!-- Ngày & Khung giờ chi tiết (Từ - Đến) -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ngày Thuê:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding StartDate}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Từ:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableHours}" 
                                          Text="{Binding StartTimeStr, UpdateSourceTrigger=PropertyChanged}" 
                                          IsEditable="True" 
                                          Style="{StaticResource ModernComboBox}" 
                                          Height="32" 
                                          ToolTip="Chọn giờ hoặc gõ giờ tự do (Ví dụ: 08:00)"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Đến:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableHours}" 
                                          Text="{Binding EndTimeStr, UpdateSourceTrigger=PropertyChanged}" 
                                          IsEditable="True" 
                                          Style="{StaticResource ModernComboBox}" 
                                          Height="32" 
                                          ToolTip="Chọn giờ hoặc gõ giờ tự do (Ví dụ: 12:00)"/>
                            </StackPanel>
                        </Grid>

                        <!-- Thông báo khi chưa chọn khung giờ hợp lệ -->
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8"
                                Visibility="{Binding IsTimeRangeSelected, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="⏱️ Vui lòng chọn khung giờ (Từ - Đến) hoặc kéo chuột chọn trên Thời khóa biểu" FontSize="11" Foreground="#B45309" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Tự động tính thời lượng & Tổng tiền dự kiến -->
                        <StackPanel Visibility="{Binding IsTimeRangeSelected, Converter={StaticResource BoolToVis}}">
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                                <Grid>
                                    <TextBlock Text="⏱️ Thời Lượng Dự Kiến:" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DurationDisplay}" FontSize="11.5" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <TextBlock Text="Tổng Tiền Dự Kiến:" FontSize="11" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EstimatedTotalAmount, Converter={StaticResource CurrencyConv}}" FontSize="13" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Hình thức thanh toán: Cọc trước vs Trả toàn bộ -->
                            <TextBlock Text="Hình Thức Thanh Toán:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2,0,3"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton Content="Đặt cọc trước" IsChecked="{Binding IsDepositPayment}" Margin="0,0,16,0" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <RadioButton Content="Thanh toán toàn bộ" IsChecked="{Binding IsFullPayment}" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </StackPanel>

                            <!-- Nếu chọn Đặt cọc trước -->
                            <StackPanel Visibility="{Binding IsDepositPayment, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Số Tiền Cọc:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding DepositAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" Style="{StaticResource ModernTextBox}" Height="30"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Còn Lại (Thu sau):" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding RemainingEstimatedAmount, Mode=OneWay, Converter={StaticResource CurrencyConv}}" IsReadOnly="True" Style="{StaticResource ModernTextBox}" Height="30" FontWeight="Bold" Foreground="#2563EB"/>
                                    </StackPanel>
                                </Grid>
                                <!-- Cảnh báo đỏ nếu nhập cọc > tổng tiền -->
                                <TextBlock Text="{Binding DepositErrorMessage}" Visibility="{Binding IsDepositInvalid, Converter={StaticResource BoolToVis}}" FontSize="10.5" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,4"/>
                            </StackPanel>

                            <!-- Nếu chọn Thanh toán toàn bộ -->
                            <StackPanel Visibility="{Binding IsFullPayment, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                <TextBlock Text="Số Tiền Thu Ngay:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding EstimatedTotalAmount, Mode=OneWay, Converter={StaticResource CurrencyConv}}" IsReadOnly="True" Style="{StaticResource ModernTextBox}" Height="30" FontWeight="Bold" Foreground="#16A34A"/>
                            </StackPanel>

                            <!-- Phương thức ghi nợ / thanh toán -->
                            <TextBlock Text="Phương Thức Ghi Nợ / Thanh Toán:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                            <ComboBox SelectedValue="{Binding BookingBillingType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Height="32" Margin="0,0,0,6">
                                <ComboBoxItem Content="🧾 Thanh toán trực tiếp (Thu tiền ngay tại quầy)" Tag="{x:Static models:BillingType.DirectPayment}"/>
                                <ComboBoxItem Content="🏨 Ghi nợ vào phòng (Trả khi Check-out)" Tag="{x:Static models:BillingType.ChargeToRoom}" IsEnabled="{Binding CanChooseBookingRoomBill}"/>
                            </ComboBox>

                            <!-- Hình thức thu tiền: Tiền mặt / Chuyển khoản (Chỉ hiển thị khi Thanh toán trực tiếp) -->
                            <StackPanel Visibility="{Binding IsDirectBookingPayment, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                <TextBlock Text="Hình thức thu tiền:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2,0,3"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Tiền mặt" IsChecked="{Binding IsBookingCash, Mode=TwoWay}" Margin="0,0,16,0" Foreground="#334155"/>
                                    <RadioButton Content="Chuyển khoản" IsChecked="{Binding IsBookingBankTransfer, Mode=TwoWay}" Foreground="#334155"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Banner thông báo Ghi nợ vào phòng -->
                            <Border Visibility="{Binding IsRoomChargeBookingPayment, Converter={StaticResource BoolToVis}}" 
                                    Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                <TextBlock Text="{Binding BookingRoomChargeNoticeText}" FontSize="11" Foreground="#92400E" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="Ghi Chú Đặt Sảnh:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding BookingNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="30" Margin="0,0,0,10"/>
                        </StackPanel>

                        <Button Content="{Binding ConfirmButtonLabel}" Style="{StaticResource GreenButton}" Height="38" FontSize="12" Command="{Binding BookSpaceCommand}" Margin="0,0,0,14"/>

                        <!-- GIAI ĐOẠN 2: KẾT THÚC SỰ KIỆN & QUYẾT TOÁN CUỐI -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="🏁 KẾT THÚC SỰ KIỆN &amp; QUYẾT TOÁN" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>

                                <TextBlock Text="Chọn đơn cần quyết toán:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding SelectableEventBookings}" 
                                          SelectedItem="{Binding SelectedBookingToComplete}" 
                                          DisplayMemberPath="BookingDisplay" 
                                          Height="32" 
                                          Margin="0,0,0,8"/>

                                <!-- Bảng quyết toán chi tiết -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Tổng tiền dự kiến:" FontSize="11" Foreground="#475569"/>
                                            <TextBlock Text="{Binding SettlementEstimatedTotal, StringFormat='{}{0:N0} đ'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Chi phí phát sinh / hư hại:" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding ExtraFee, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="26" Style="{StaticResource ModernTextBox}" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        </Grid>
                                        <Separator Margin="0,4" Background="#E2E8F0"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Tổng cộng:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                            <TextBlock Text="{Binding SettlementGrandTotal, StringFormat='{}{0:N0} đ'}" FontSize="12" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Đã thu trước (Đặt cọc):" FontSize="11" Foreground="#059669"/>
                                            <TextBlock Text="{Binding SettlementPaidBefore, StringFormat='- {0:N0} đ'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#059669" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Separator Margin="0,4" Background="#CBD5E1"/>
                                        <Grid Margin="0,2,0,2">
                                            <TextBlock Text="CÒN PHẢI THU:" FontSize="12" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SettlementRemainingToPay, StringFormat='{}{0:N0} đ'}" FontSize="15" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Phương Thức Ghi Nợ / Thanh Toán:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <ComboBox SelectedValue="{Binding SettlementBillingType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Height="32" Margin="0,0,0,6">
                                    <ComboBoxItem Content="🧾 Thanh toán trực tiếp (Thu tiền ngay tại quầy)" Tag="{x:Static models:BillingType.DirectPayment}"/>
                                    <ComboBoxItem Content="🏨 Ghi nợ vào phòng (Trả khi Check-out)" Tag="{x:Static models:BillingType.ChargeToRoom}" IsEnabled="{Binding CanChargeSettlementToRoom}"/>
                                </ComboBox>

                                <!-- Hình thức thu tiền: Tiền mặt / Chuyển khoản (Chỉ hiển thị khi Thanh toán trực tiếp) -->
                                <StackPanel Visibility="{Binding IsDirectSettlementPayment, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                    <TextBlock Text="Hình thức thu tiền:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Tiền mặt" IsChecked="{Binding IsSettlementCash, Mode=TwoWay}" Margin="0,0,16,0" Foreground="#334155"/>
                                        <RadioButton Content="Chuyển khoản" IsChecked="{Binding IsSettlementBankTransfer, Mode=TwoWay}" Foreground="#334155"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Banner thông báo Ghi nợ vào phòng -->
                                <Border Visibility="{Binding IsRoomChargeSettlementPayment, Converter={StaticResource BoolToVis}}" 
                                        Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding RoomChargeNoticeText}" FontSize="11" Foreground="#92400E" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="Ghi chú hư hại:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding DamageNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="28" Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Người xác nhận thu:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CreatorStaffDisplay}" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                                </Grid>

                                <Button Content="{Binding SettlementButtonLabel}" 
                                        IsEnabled="{Binding CanCollectSettlement}"
                                        Style="{StaticResource GoldButton}" 
                                        Height="36" 
                                        FontSize="12" 
                                        Command="{Binding CompleteBookingCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
