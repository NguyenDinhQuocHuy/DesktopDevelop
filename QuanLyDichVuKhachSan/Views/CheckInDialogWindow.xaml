<Window x:Class="QuanLyDichVuKhachSan.Views.CheckInDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:QuanLyDichVuKhachSan.Helpers"
        mc:Ignorable="d"
        Title="Đăng Ký Nhận Phòng - Dalat Hotel" 
        Height="650" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="18">
        <!-- Dialog Card -->
        <Border Background="White" CornerRadius="14" Padding="22" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Divider -->
                    <RowDefinition Height="*"/>    <!-- Form Fields (ScrollViewer) -->
                    <RowDefinition Height="Auto"/> <!-- Error Message -->
                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="🔑 ĐĂNG KÝ NHẬN PHÒNG" FontSize="17" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock x:Name="TxtRoomDetails" Text="Phòng: P.101 - Phòng Standard (Tầng 1)" FontSize="12.5" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="DALAT HOTEL" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                    </Border>
                </Grid>

                <!-- 2. Divider -->
                <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,0,0,12"/>

                <!-- 3. Form Fields -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,6,0">
                        <!-- Customer Name -->
                        <TextBlock Text="👤 Họ &amp; Tên Khách Hàng (*)" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCustomerName" 
                                 helpers:InputHelper.ValidationMode="NameOnly"
                                 Style="{StaticResource ModernTextBox}" 
                                 Height="36" 
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,10"/>

                        <!-- Phone & CCCD -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Phone Number -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📞 Số Điện Thoại (*)" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPhoneNumber" 
                                         helpers:InputHelper.ValidationMode="PhoneOnly"
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="36" 
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Identity Card / CCCD -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CCCD / Passport" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtIdentityCard" 
                                         helpers:InputHelper.ValidationMode="PhoneOnly"
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="36" 
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- CHECK-IN DATE TIME -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="📥 Thời Gian Nhận Phòng" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="DpCheckInDate" Height="36" SelectedDateChanged="DpCheckInDate_SelectedDateChanged"/>
                                <TextBox x:Name="TxtCheckInTime" Grid.Column="2" Height="36" Style="{StaticResource ModernTextBox}" 
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- CHECK-OUT DATE TIME -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="📤 Thời Gian Trả Phòng" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="DpCheckOutDate" Height="36" SelectedDateChanged="DpCheckOutDate_SelectedDateChanged"/>
                                <TextBox x:Name="TxtCheckOutTime" Grid.Column="2" Text="12:00" Height="36" Style="{StaticResource ModernTextBox}" 
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Note -->
                        <TextBlock Text="📝 Ghi Chú Lưu Trú (Yêu cầu đặc biệt)" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNote" 
                                 Style="{StaticResource ModernTextBox}" 
                                 Height="36" 
                                 VerticalContentAlignment="Center"
                                 Text="Khách nhận phòng trực tiếp"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. Error Message -->
                <Border x:Name="PnlError" Grid.Row="3" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,4,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" Text="Vui lòng nhập tên khách hàng!" Foreground="#DC2626" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>

                <!-- 5. Action Buttons -->
                <Grid Grid.Row="4" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="❌ Hủy Bỏ" Click="CancelButton_Click" Height="40" Style="{StaticResource OutlineButton}" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="🔑 Xác Nhận Nhận Phòng" Click="ConfirmButton_Click" Height="40" Style="{StaticResource PrimaryButton}" Background="#D97706" FontWeight="Bold" Margin="6,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
